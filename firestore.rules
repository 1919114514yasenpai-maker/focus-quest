rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserSave(data) {
      return data is map
        && data.keys().hasAll(['stats', 'equipment', 'inventory'])
        && data.stats is map
        && data.equipment is map
        && data.inventory is list;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /saves/{saveId} {
        allow get, list: if isOwner(userId) && isValidId(userId) && isValidId(saveId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(saveId) && isValidUserSave(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(saveId);
      }
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
