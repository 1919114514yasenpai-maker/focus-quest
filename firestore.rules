rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);

      match /saves/{saveId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /guilds/{guildId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /votes/{voterId} {
        allow read: if isSignedIn();
        allow write: if isOwner(voterId);
      }

      match /shop/{itemId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    match /market/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                       incoming().sellerId == request.auth.uid &&
                       incoming().keys().hasAll(['sellerId', 'sellerName', 'itemData', 'startingBid', 'currentBid', 'expiresAt', 'status', 'createdAt']);
      allow update: if isSignedIn(); 
    }
  }
}
