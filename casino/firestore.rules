rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == '1919114514yasenpai@gmail.com' ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      allow create: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isValidId(userId)
                    && (incoming().get('role', 'user') == 'user' || request.auth.token.get('email', '') == '1919114514yasenpai@gmail.com');
                    
      allow update: if isSignedIn() 
                    && isValidId(userId)
                    && (
                      isAdmin() || 
                      (request.auth.uid == userId && incoming().get('role', 'user') == existing().get('role', 'user'))
                    );
                    
      allow delete: if isAdmin();
    }
  }
}
